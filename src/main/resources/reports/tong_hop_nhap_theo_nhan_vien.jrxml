    <parameter name="p_companyName" class="java.lang.String"/>
    <parameter name="p_companyAddress" class="java.lang.String"/>
    <parameter name="p_companyPhone" class="java.lang.String"/>
    <parameter name="p_companyEmail" class="java.lang.String"/>
    <parameter name="p_logoImage" class="java.lang.Object"/>
    <parameter name="p_reportTitle" class="java.lang.String"/>
    <parameter name="p_tuNgay" class="java.lang.String"/>
    <parameter name="p_denNgay" class="java.lang.String"/>

    <field name="stt" class="java.lang.Integer"/>
    <field name="tenNhanVien" class="java.lang.String"/>
    <field name="tienHang" class="java.lang.Double"/>
    <field name="tienGiamGia" class="java.lang.Double"/>
    <field name="phiVanChuyen" class="java.lang.Double"/>
    <field name="tongCong" class="java.lang.Double"/>

    <variable name="v_tot_tienHang" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{tienHang} != null ? $F{tienHang} : Double.valueOf(0.0)]]></variableExpression>
        <initialValueExpression><![CDATA[Double.valueOf(0.0)]]></initialValueExpression>
    </variable>
    <variable name="v_tot_tienGiamGia" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{tienGiamGia} != null ? $F{tienGiamGia} : Double.valueOf(0.0)]]></variableExpression>
        <initialValueExpression><![CDATA[Double.valueOf(0.0)]]></initialValueExpression>
    </variable>
    <variable name="v_tot_phiVanChuyen" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{phiVanChuyen} != null ? $F{phiVanChuyen} : Double.valueOf(0.0)]]></variableExpression>
        <initialValueExpression><![CDATA[Double.valueOf(0.0)]]></initialValueExpression>
    </variable>
    <variable name="v_tot_tongCong" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{tongCong} != null ? $F{tongCong} : Double.valueOf(0.0)]]></variableExpression>
        <initialValueExpression><![CDATA[Double.valueOf(0.0)]]></initialValueExpression>
    </variable>

    <title>
        <band height="105">
            <image scaleImage="RetainShape" onErrorType="Blank">
                <reportElement x="237" y="0" width="60" height="40"/>
                <imageExpression><![CDATA[$P{p_logoImage}]]></imageExpression>
            </image>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="42" width="535" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{p_companyName} != null ? $P{p_companyName} : "Công ty TNHH Ngọc Châu Âu"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="58" width="535" height="14"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Địa chỉ: " + ($P{p_companyAddress} != null ? $P{p_companyAddress} : "455 Sư Vạn Hạnh, P.12, Q.10, TPHCM")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="72" width="535" height="14"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Điện thoại: " + ($P{p_companyPhone} != null ? $P{p_companyPhone} : "(08) 6264 5788") + ($P{p_companyEmail} != null && !$P{p_companyEmail}.isEmpty() ? ", Email: " + $P{p_companyEmail} : "")]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="0" y="88" width="200" height="15"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8" isItalic="false"/>
                </textElement>
                <textFieldExpression><![CDATA[($P{p_tuNgay} != null && !$P{p_tuNgay}.isEmpty()) ? ("Ngày từ " + $P{p_tuNgay} + ($P{p_denNgay} != null && !$P{p_denNgay}.isEmpty() ? " đến " + $P{p_denNgay} : "")) : ""]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="160" y="86" width="375" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
