    <variable name="v_bh_tongCong" class="java.lang.Double" resetType="Group" resetGroup="GroupSection" calculation="Sum">
        <variableExpression><![CDATA[$F{sectionType} == 1 ? $F{tongCong} : Double.valueOf(0.0)]]></variableExpression>
    </variable>
    <variable name="v_bh_tienMat" class="java.lang.Double" resetType="Group" resetGroup="GroupSection" calculation="Sum">
