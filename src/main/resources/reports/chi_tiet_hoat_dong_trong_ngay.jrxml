    </variable>
    <variable name="v_bh_chuyenKhoan" class="java.lang.Double" resetType="Group" resetGroup="GroupSection" calculation="Sum">
        <variableExpression><![CDATA[$F{sectionType} == 1 ? $F{chuyenKhoan} : Double.valueOf(0.0)]]></variableExpression>
    </variable>
    <variable name="v_bh_theAtm" class="java.lang.Double" resetType="Group" resetGroup="GroupSection" calculation="Sum">
        <variableExpression><![CDATA[$F{sectionType} == 1 ? $F{theAtm} : Double.valueOf(0.0)]]></variableExpression>
    </variable>
    <variable name="v_bh_conNo" class="java.lang.Double" resetType="Group" resetGroup="GroupSection" calculation="Sum">
