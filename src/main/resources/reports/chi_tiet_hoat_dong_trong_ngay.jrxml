    <title>
        <band height="95">
            <image scaleImage="RetainShape" onErrorType="Blank">
                <reportElement x="0" y="0" width="100" height="40"/>
                <imageExpression><![CDATA[$P{p_logoImage}]]></imageExpression>
            </image>
            <textField isBlankWhenNull="true">
                <reportElement x="100" y="0" width="435" height="15"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{p_companyName}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="100" y="15" width="435" height="13"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA["Địa chỉ: " + ($P{p_companyAddress} != null ? $P{p_companyAddress} : "")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="100" y="28" width="435" height="13"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA["Điện thoại: " + ($P{p_companyPhone} != null ? $P{p_companyPhone} : "") + ($P{p_companyEmail} != null && !$P{p_companyEmail}.isEmpty() ? "   Email: " + $P{p_companyEmail} : "")]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="0" y="52" width="260" height="15"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
