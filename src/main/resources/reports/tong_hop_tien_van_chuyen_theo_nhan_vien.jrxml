<?xml version="1.0" encoding="UTF-8"?>
<jasperReport whenNoDataType="AllSectionsNoDetail"
              xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="tong_hop_tien_van_chuyen_theo_nhan_vien"
              pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">

    <parameter name="p_companyName" class="java.lang.String"/>
    <parameter name="p_companyAddress" class="java.lang.String"/>
    <parameter name="p_companyPhone" class="java.lang.String"/>
    <parameter name="p_companyEmail" class="java.lang.String"/>
    <parameter name="p_logoImage" class="java.lang.Object"/>
    <parameter name="p_reportTitle" class="java.lang.String"/>
    <parameter name="p_tuNgay" class="java.lang.String"/>
    <parameter name="p_denNgay" class="java.lang.String"/>

    <field name="stt" class="java.lang.Integer"/>
    <field name="ngay" class="java.lang.String"/>
    <field name="name" class="java.lang.String"/>
    <field name="tongCong" class="java.lang.Double"/>
    <field name="trichNhanVien" class="java.lang.Double"/>

    <variable name="v_totalTongCong" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{tongCong}]]></variableExpression>
    </variable>
    <variable name="v_totalTrichNhanVien" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{trichNhanVien}]]></variableExpression>
    </variable>

    <title>
        <band height="120">
            <image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" onErrorType="Blank">
                <reportElement x="0" y="0" width="100" height="50"/>
                <imageExpression><![CDATA[$P{p_logoImage}]]></imageExpression>
            </image>
            <textField isBlankWhenNull="true">
                <reportElement x="160" y="0" width="375" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{p_companyName} != null ? $P{p_companyName} : "Công ty TNHH Ngọc Châu Âu"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="160" y="16" width="375" height="14"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Địa chỉ: " + ($P{p_companyAddress} != null ? $P{p_companyAddress} : "455 Sư Vạn Hạnh, P.12, Q.10, TPHCM")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="160" y="30" width="375" height="14"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Điện thoại: " + ($P{p_companyPhone} != null ? $P{p_companyPhone} : "(08) 6264 5788") + ($P{p_companyEmail} != null && !$P{p_companyEmail}.isEmpty() ? ", Email: " + $P{p_companyEmail} : "")]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="0" y="55" width="535" height="22"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{p_reportTitle} != null ? $P{p_reportTitle} : "TỔNG HỢP TIỀN VẬN CHUYỂN THEO NHÂN VIÊN"]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="0" y="77" width="535" height="14"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Từ ngày: " + ($P{p_tuNgay} != null ? $P{p_tuNgay} : "")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="91" width="535" height="14"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Đến ngày: " + ($P{p_denNgay} != null ? $P{p_denNgay} : "")]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="24">
            <staticText>
                <reportElement mode="Opaque" x="0" y="0" width="45" height="24" backcolor="#FFFFFF"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[STT]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="45" y="0" width="110" height="24" backcolor="#FFFFFF"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[NGAY]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="155" y="0" width="160" height="24" backcolor="#FFFFFF"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[NAME]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="315" y="0" width="110" height="24" backcolor="#FFFFFF"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[TONGCONG]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="425" y="0" width="110" height="24" backcolor="#FFFFFF"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[TRICHNHANVIEN]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="45" height="20"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{stt}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="45" y="0" width="110" height="20"/>
                <box leftPadding="4"><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{ngay}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="155" y="0" width="160" height="20"/>
                <box leftPadding="6"><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{name}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0" isBlankWhenNull="true">
                <reportElement x="315" y="0" width="110" height="20"/>
                <box rightPadding="6"><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{tongCong}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0" isBlankWhenNull="true">
                <reportElement x="425" y="0" width="110" height="20"/>
                <box rightPadding="6"><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{trichNhanVien}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="100">
            <staticText>
                <reportElement x="30" y="25" width="180" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <text><![CDATA[Trưởng phòng]]></text>
            </staticText>
            <staticText>
                <reportElement x="30" y="41" width="180" height="14"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isItalic="true"/></textElement>
                <text><![CDATA[(Ký, họ tên)]]></text>
            </staticText>
            <staticText>
                <reportElement x="325" y="25" width="180" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <text><![CDATA[Người lập]]></text>
            </staticText>
            <staticText>
                <reportElement x="325" y="41" width="180" height="14"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isItalic="true"/></textElement>
                <text><![CDATA[(Ký, họ tên)]]></text>
            </staticText>
        </band>
    </summary>
</jasperReport>
