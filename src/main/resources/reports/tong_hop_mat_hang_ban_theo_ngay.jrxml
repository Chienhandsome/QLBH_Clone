                <box><topPen lineWidth="0.5" lineColor="#808080"/><leftPen lineWidth="0.5" lineColor="#808080"/><bottomPen lineWidth="0.5" lineColor="#808080"/><rightPen lineWidth="0.5" lineColor="#808080"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
