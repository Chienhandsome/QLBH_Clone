<?xml version="1.0" encoding="UTF-8"?>
<jasperReport whenNoDataType="AllSectionsNoDetail"
              xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="bao_cao_ket_qua_kinh_doanh"
              pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">

    <parameter name="p_companyName" class="java.lang.String"/>
    <parameter name="p_companyAddress" class="java.lang.String"/>
    <parameter name="p_companyPhone" class="java.lang.String"/>
    <parameter name="p_companyEmail" class="java.lang.String"/>
    <parameter name="p_logoImage" class="java.lang.Object"/>
    <parameter name="p_reportTitle" class="java.lang.String"/>
    <parameter name="p_subTitleDate" class="java.lang.String"/>

    <field name="stt" class="java.lang.String"/>
    <field name="tenMuc" class="java.lang.String"/>
    <field name="tyLeDT" class="java.lang.Double"/>
    <field name="giaTri" class="java.lang.Double"/>
    <field name="tyLe" class="java.lang.Double"/>
    <field name="tyLeCP" class="java.lang.Double"/>
    <field name="tangGiam" class="java.lang.Double"/>
    <field name="kqkdThangTruoc" class="java.lang.Double"/>
    <field name="isBold" class="java.lang.Boolean"/>
    <field name="isItalic" class="java.lang.Boolean"/>
    <field name="level" class="java.lang.Integer"/>

    <title>
        <band height="95">
            <image scaleImage="RetainShape" onErrorType="Blank">
                <reportElement x="0" y="0" width="100" height="40"/>
                <imageExpression><![CDATA[$P{p_logoImage}]]></imageExpression>
            </image>
            <textField isBlankWhenNull="true">
                <reportElement x="100" y="0" width="435" height="15"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{p_companyName}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="100" y="15" width="435" height="13"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Địa chỉ: " + ($P{p_companyAddress} != null ? $P{p_companyAddress} : "")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="100" y="28" width="435" height="13"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Điện thoại: " + ($P{p_companyPhone} != null ? $P{p_companyPhone} : "") + ($P{p_companyEmail} != null && !$P{p_companyEmail}.isEmpty() ? "   Email: " + $P{p_companyEmail} : "")]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="0" y="55" width="260" height="15"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{p_subTitleDate}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="260" y="50" width="275" height="24"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="13" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{p_reportTitle} != null ? $P{p_reportTitle} : "BÁO CÁO KẾT QUẢ KINH DOANH"]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="28">
            <staticText>
                <reportElement mode="Opaque" x="0" y="0" width="230" height="28" backcolor="#FFFFFF"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="230" y="0" width="40" height="14" backcolor="#FFFFFF"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="7" isBold="true"/></textElement>
                <text><![CDATA[]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="230" y="14" width="40" height="14" backcolor="#FFFFFF"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="7" isBold="true"/></textElement>
                <text><![CDATA[%/DT]]></text>
            </staticText>

            <staticText>
                <reportElement mode="Opaque" x="270" y="0" width="65" height="28" backcolor="#FFFFFF"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="7" isBold="true"/></textElement>
                <text><![CDATA[Giá trị]]></text>
            </staticText>

            <staticText>
                <reportElement mode="Opaque" x="335" y="0" width="40" height="14" backcolor="#FFFFFF"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="7" isBold="true"/></textElement>
                <text><![CDATA[%]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="335" y="14" width="40" height="14" backcolor="#FFFFFF"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="7" isBold="true"/></textElement>
                <text><![CDATA[%/CP]]></text>
            </staticText>

            <staticText>
                <reportElement mode="Opaque" x="375" y="0" width="40" height="28" backcolor="#FFFFFF"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="7" isBold="true"/></textElement>
                <text><![CDATA[]]></text>
            </staticText>

            <staticText>
                <reportElement mode="Opaque" x="415" y="0" width="60" height="28" backcolor="#FFFFFF"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="7" isBold="true"/></textElement>
                <text><![CDATA[Tăng giảm so với tháng trước]]></text>
            </staticText>

            <staticText>
                <reportElement mode="Opaque" x="475" y="0" width="60" height="28" backcolor="#FFFFFF"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="7" isBold="true"/></textElement>
                <text><![CDATA[KQKD tháng trước]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <!-- STT -->
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="25" height="18"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{stt}]]></textFieldExpression>
            </textField>
            <!-- Diễn giải / Tên mục -->
            <textField isBlankWhenNull="true">
                <reportElement x="25" y="0" width="205" height="18"/>
                <box leftPadding="5"><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{tenMuc}]]></textFieldExpression>
            </textField>
            <!-- %/DT -->
            <textField pattern="#,##0.##" isBlankWhenNull="true">
                <reportElement x="230" y="0" width="40" height="18"/>
                <box rightPadding="3"><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{tyLeDT} != null ? ($F{tyLeDT} == 0.0 ? "-" : String.format("%.0f%%", $F{tyLeDT})) : "-"]]></textFieldExpression>
            </textField>
            <!-- Giá trị -->
            <textField pattern="#,##0.##" isBlankWhenNull="true">
                <reportElement x="270" y="0" width="65" height="18"/>
                <box rightPadding="3"><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{giaTri} != null ? $F{giaTri} : Double.valueOf(0.0)]]></textFieldExpression>
            </textField>
            <!-- % -->
            <textField isBlankWhenNull="true">
                <reportElement x="335" y="0" width="40" height="18"/>
                <box rightPadding="3"><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{tyLe} != null ? ($F{tyLe} == 0.0 ? "-" : String.format("%.0f%%", $F{tyLe})) : ($F{tyLeCP} != null ? ($F{tyLeCP} == 0.0 ? "-" : String.format("%.0f%%", $F{tyLeCP})) : "-")]]></textFieldExpression>
            </textField>
            <!-- %/CP (empty column holder) -->
            <staticText>
                <reportElement x="375" y="0" width="40" height="18"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <text><![CDATA[-]]></text>
            </staticText>
            <!-- Tăng giảm so với tháng trước -->
            <textField pattern="#,##0.##" isBlankWhenNull="true">
                <reportElement x="415" y="0" width="60" height="18"/>
                <box rightPadding="3"><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{tangGiam} != null ? $F{tangGiam} : Double.valueOf(0.0)]]></textFieldExpression>
            </textField>
            <!-- KQKD tháng trước -->
            <textField pattern="#,##0.##" isBlankWhenNull="true">
                <reportElement x="475" y="0" width="60" height="18"/>
                <box rightPadding="3"><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{kqkdThangTruoc} != null ? $F{kqkdThangTruoc} : Double.valueOf(0.0)]]></textFieldExpression>
            </textField>
        </band>
    </detail>

</jasperReport>
