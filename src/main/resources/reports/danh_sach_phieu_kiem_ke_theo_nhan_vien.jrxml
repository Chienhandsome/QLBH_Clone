<?xml version="1.0" encoding="UTF-8"?>
<jasperReport whenNoDataType="AllSectionsNoDetail"
              xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="danh_sach_phieu_kiem_ke_theo_nhan_vien"
              pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="782" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">

    <parameter name="p_companyName" class="java.lang.String"/>
    <parameter name="p_companyAddress" class="java.lang.String"/>
    <parameter name="p_companyPhone" class="java.lang.String"/>
    <parameter name="p_companyEmail" class="java.lang.String"/>
    <parameter name="p_logoImage" class="java.lang.Object"/>
    <parameter name="p_reportTitle" class="java.lang.String"/>
    <parameter name="p_tuNgay" class="java.lang.String"/>
    <parameter name="p_denNgay" class="java.lang.String"/>

    <field name="stt" class="java.lang.Integer"/>
    <field name="groupNhanVien" class="java.lang.String"/>
    <field name="ngay" class="java.lang.String"/>
    <field name="soPhieu" class="java.lang.String"/>
    <field name="dienGiai" class="java.lang.String"/>
    <field name="ghiChu" class="java.lang.String"/>

    <group name="GroupNhanVien">
        <groupExpression><![CDATA[$F{groupNhanVien}]]></groupExpression>
        <groupHeader>
            <band height="20">
                <printWhenExpression><![CDATA[$F{groupNhanVien} != null && !$F{groupNhanVien}.isEmpty()]]></printWhenExpression>
                <textField isBlankWhenNull="true">
                    <reportElement x="0" y="0" width="782" height="20"/>
                    <box leftPadding="5">
                        <topPen lineWidth="0.5" lineColor="#808080"/>
                        <leftPen lineWidth="0.5" lineColor="#808080"/>
                        <bottomPen lineWidth="0.5" lineColor="#808080"/>
                        <rightPen lineWidth="0.5" lineColor="#808080"/>
                    </box>
                    <textElement verticalAlignment="Middle">
                        <font fontName="SansSerif" size="9" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$F{groupNhanVien}]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
    </group>

    <title>
        <band height="90">
            <image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" onErrorType="Blank">
                <reportElement x="0" y="0" width="100" height="50"/>
                <imageExpression><![CDATA[$P{p_logoImage}]]></imageExpression>
            </image>
            <textField isBlankWhenNull="true">
                <reportElement x="200" y="0" width="382" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{p_companyName} != null ? $P{p_companyName} : "Công ty TNHH Ngọc Châu Âu"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="200" y="18" width="382" height="15"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Địa chỉ: " + ($P{p_companyAddress} != null ? $P{p_companyAddress} : "455 Sư Vạn Hạnh, P.12, Q.10, TPHCM")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="200" y="33" width="382" height="15"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Điện thoại: " + ($P{p_companyPhone} != null ? $P{p_companyPhone} : "(08) 6264 5788") + ($P{p_companyEmail} != null && !$P{p_companyEmail}.isEmpty() ? ", Email: " + $P{p_companyEmail} : "")]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="160" y="55" width="462" height="22"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{p_reportTitle} != null ? $P{p_reportTitle} : "DANH SÁCH PHIẾU KIỂM KÊ THEO NHÂN VIÊN"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="200" y="75" width="382" height="13"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA[($P{p_tuNgay} != null && !$P{p_tuNgay}.isEmpty()) ? ("Từ ngày " + $P{p_tuNgay} + ($P{p_denNgay} != null && !$P{p_denNgay}.isEmpty() ? " đến ngày " + $P{p_denNgay} : "")) : ""]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="24">
            <staticText>
                <reportElement mode="Opaque" x="0" y="0" width="45" height="24" backcolor="#FFFFFF"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[STT]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="45" y="0" width="100" height="24" backcolor="#FFFFFF"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Ngày]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="145" y="0" width="110" height="24" backcolor="#FFFFFF"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Số phiếu]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="255" y="0" width="300" height="24" backcolor="#FFFFFF"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Diễn giải]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="555" y="0" width="227" height="24" backcolor="#FFFFFF"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Ghi chú]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="45" height="18"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{stt}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="45" y="0" width="100" height="18"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{ngay}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="145" y="0" width="110" height="18"/>
                <box leftPadding="4"><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{soPhieu}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="255" y="0" width="300" height="18"/>
                <box leftPadding="4"><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{dienGiai}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="555" y="0" width="227" height="18"/>
                <box leftPadding="4"><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{ghiChu}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="90">
            <staticText>
                <reportElement x="555" y="15" width="227" height="15"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isItalic="true"/></textElement>
                <text><![CDATA[Ngày ..... tháng ..... năm 20...]]></text>
            </staticText>
            <staticText>
                <reportElement x="555" y="30" width="227" height="15"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Người lập biểu]]></text>
            </staticText>
            <staticText>
                <reportElement x="555" y="45" width="227" height="12"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="7" isItalic="true"/></textElement>
                <text><![CDATA[(Ký, họ tên)]]></text>
            </staticText>
        </band>
    </summary>

</jasperReport>
