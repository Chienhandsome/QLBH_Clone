    <summary>
        <band height="100">
            <staticText>
                <reportElement mode="Opaque" x="0" y="0" width="435" height="20" backcolor="#E8E8E8"/>
                <box rightPadding="5"><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
