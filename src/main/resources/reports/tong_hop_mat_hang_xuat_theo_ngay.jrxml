<?xml version="1.0" encoding="UTF-8"?>
<jasperReport whenNoDataType="AllSectionsNoDetail"
              xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="tong_hop_mat_hang_xuat_theo_ngay"
              pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">

    <parameter name="p_companyName" class="java.lang.String"/>
    <parameter name="p_companyAddress" class="java.lang.String"/>
    <parameter name="p_companyPhone" class="java.lang.String"/>
    <parameter name="p_companyEmail" class="java.lang.String"/>
    <parameter name="p_logoImage" class="java.lang.Object"/>
    <parameter name="p_reportTitle" class="java.lang.String"/>
    <parameter name="p_tuNgay" class="java.lang.String"/>
    <parameter name="p_denNgay" class="java.lang.String"/>

    <field name="stt" class="java.lang.Integer"/>
    <field name="groupSoLuong" class="java.lang.String"/>
    <field name="matHang" class="java.lang.String"/>
    <field name="dvt" class="java.lang.String"/>
    <field name="donGia" class="java.lang.Double"/>
    <field name="thanhTien" class="java.lang.Double"/>

    <variable name="v_sub_thanhTien" class="java.lang.Double" resetType="Group" resetGroup="GroupSoLuong" calculation="Sum">
        <variableExpression><![CDATA[$F{thanhTien} != null ? $F{thanhTien} : Double.valueOf(0.0)]]></variableExpression>
        <initialValueExpression><![CDATA[Double.valueOf(0.0)]]></initialValueExpression>
    </variable>

    <variable name="v_tot_thanhTien" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{thanhTien} != null ? $F{thanhTien} : Double.valueOf(0.0)]]></variableExpression>
        <initialValueExpression><![CDATA[Double.valueOf(0.0)]]></initialValueExpression>
    </variable>

    <group name="GroupSoLuong">
        <groupExpression><![CDATA[$F{groupSoLuong}]]></groupExpression>
        <groupHeader>
            <band height="20">
                <printWhenExpression><![CDATA[$F{groupSoLuong} != null && !$F{groupSoLuong}.isEmpty()]]></printWhenExpression>
                <textField isBlankWhenNull="true">
                    <reportElement x="0" y="0" width="535" height="20"/>
                    <box rightPadding="5">
                        <topPen lineWidth="0.5" lineColor="#808080"/>
                        <leftPen lineWidth="0.5" lineColor="#808080"/>
                        <bottomPen lineWidth="0.5" lineColor="#808080"/>
                        <rightPen lineWidth="0.5" lineColor="#808080"/>
                    </box>
                    <textElement textAlignment="Right" verticalAlignment="Middle">
                        <font fontName="SansSerif" size="9" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$F{groupSoLuong}]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="20">
                <staticText>
                    <reportElement mode="Opaque" x="0" y="0" width="435" height="20" backcolor="#FFFFFF"/>
                    <box rightPadding="5">
                        <topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/>
                    </box>
                    <textElement textAlignment="Right" verticalAlignment="Middle">
                        <font fontName="SansSerif" size="9" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Tổng cộng]]></text>
                </staticText>
                <textField pattern="#,##0.00" isBlankWhenNull="true">
                    <reportElement mode="Opaque" x="435" y="0" width="100" height="20" backcolor="#FFFFFF"/>
                    <box rightPadding="4"><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$V{v_sub_thanhTien}]]></textFieldExpression>
                </textField>
            </band>
        </groupFooter>
    </group>

    <title>
        <band height="90">
            <image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" onErrorType="Blank">
                <reportElement x="0" y="0" width="100" height="50"/>
                <imageExpression><![CDATA[$P{p_logoImage}]]></imageExpression>
            </image>
            <textField isBlankWhenNull="true">
                <reportElement x="120" y="0" width="415" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{p_companyName} != null ? $P{p_companyName} : "Công ty TNHH Ngọc Châu Âu"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="120" y="18" width="415" height="15"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Địa chỉ: " + ($P{p_companyAddress} != null ? $P{p_companyAddress} : "455 Sư Vạn Hạnh, P.12, Q.10, TPHCM")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="120" y="33" width="415" height="15"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Điện thoại: " + ($P{p_companyPhone} != null ? $P{p_companyPhone} : "(08) 6264 5788") + ($P{p_companyEmail} != null && !$P{p_companyEmail}.isEmpty() ? ", Email: " + $P{p_companyEmail} : "")]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="80" y="55" width="455" height="22"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{p_reportTitle} != null ? $P{p_reportTitle} : "TỔNG HỢP MẶT HÀNG XUẤT THEO NGÀY"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="120" y="75" width="415" height="13"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA[($P{p_tuNgay} != null && !$P{p_tuNgay}.isEmpty()) ? ("Từ ngày " + $P{p_tuNgay} + ($P{p_denNgay} != null && !$P{p_denNgay}.isEmpty() ? " đến ngày " + $P{p_denNgay} : "")) : ""]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="24">
            <staticText>
                <reportElement mode="Opaque" x="0" y="0" width="35" height="24" backcolor="#FFFFFF"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
