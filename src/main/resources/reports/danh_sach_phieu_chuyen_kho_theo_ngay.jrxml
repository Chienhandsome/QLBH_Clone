              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="danh_sach_phieu_chuyen_kho_theo_ngay"
              pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">

    <parameter name="p_companyName" class="java.lang.String"/>
    <parameter name="p_companyAddress" class="java.lang.String"/>
    <parameter name="p_companyPhone" class="java.lang.String"/>
    <parameter name="p_companyEmail" class="java.lang.String"/>
    <parameter name="p_logoImage" class="java.lang.Object"/>
    <parameter name="p_reportTitle" class="java.lang.String"/>
    <parameter name="p_tuNgay" class="java.lang.String"/>
    <parameter name="p_denNgay" class="java.lang.String"/>

    <field name="stt" class="java.lang.Integer"/>
    <field name="soPhieu" class="java.lang.String"/>
    <field name="dienGiai" class="java.lang.String"/>
    <field name="khoXuat" class="java.lang.String"/>
    <field name="khoNhap" class="java.lang.String"/>
    <field name="nhanVienXuat" class="java.lang.String"/>
    <field name="nhanVienNhap" class="java.lang.String"/>
    <field name="tongCong" class="java.lang.Double"/>
    <field name="ghiChu" class="java.lang.String"/>

    <variable name="v_tot_tongCong" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{tongCong} != null ? $F{tongCong} : Double.valueOf(0.0)]]></variableExpression>
        <initialValueExpression><![CDATA[Double.valueOf(0.0)]]></initialValueExpression>
    </variable>

    <title>
        <band height="105">
            <image scaleImage="RetainShape" onErrorType="Blank">
                <reportElement x="10" y="0" width="120" height="45"/>
                <imageExpression><![CDATA[$P{p_logoImage}]]></imageExpression>
            </image>
            <textField isBlankWhenNull="true">
                <reportElement x="140" y="0" width="395" height="15"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{p_companyName}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="140" y="15" width="395" height="14"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Địa chỉ: " + ($P{p_companyAddress} != null ? $P{p_companyAddress} : "")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="140" y="29" width="395" height="14"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Điện thoại: " + ($P{p_companyPhone} != null ? $P{p_companyPhone} : "") + ($P{p_companyEmail} != null && !$P{p_companyEmail}.isEmpty() ? ", Email: " + $P{p_companyEmail} : "")]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="170" y="55" width="365" height="22"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="13" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{p_reportTitle} != null ? $P{p_reportTitle} : "DANH SÁCH PHIẾU CHUYỂN KHO THEO NGÀY"]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="0" y="60" width="250" height="16"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8" isItalic="false"/>
                </textElement>
                <textFieldExpression><![CDATA[($P{p_tuNgay} != null && !$P{p_tuNgay}.isEmpty() && $P{p_denNgay} != null && !$P{p_denNgay}.isEmpty()) ?
                    ($P{p_tuNgay}.equals($P{p_denNgay}) ? ("Ngày: " + $P{p_tuNgay}) : ("Ngày: " + $P{p_tuNgay} + " - " + $P{p_denNgay})) : ""]]></textFieldExpression>
            </textField>
        </band>
    </title>

