                    <reportElement x="0" y="0" width="555" height="20"/>
                    <box leftPadding="5">
                        <topPen lineWidth="0.5" lineColor="#808080"/>
                        <leftPen lineWidth="0.5" lineColor="#808080"/>
                        <bottomPen lineWidth="0.5" lineColor="#808080"/>
                        <rightPen lineWidth="0.5" lineColor="#808080"/>
                    </box>
                    <textElement verticalAlignment="Middle">
                        <font fontName="SansSerif" size="9" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Nhóm khách: " + ($F{nhomKhachHang} != null ? $F{nhomKhachHang} : "")]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
    </group>

    <title>
        <band height="105">
