                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Địa chỉ: " + ($P{p_companyAddress} != null ? $P{p_companyAddress} : "455 Sư Vạn Hạnh, P.12, Q.10, TPHCM")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="130" y="34" width="370" height="13"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Điện thoại: " + ($P{p_companyPhone} != null ? $P{p_companyPhone} : "(08) 6264 5788") + ($P{p_companyEmail} != null ? "   Email: " + $P{p_companyEmail} : "   Email: info@ngocchauau.vn")]]></textFieldExpression>
            </textField>

            <!-- Subheader Filter Text Left -->
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="55" width="200" height="16"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{p_filterText} != null ? $P{p_filterText} : "Nhóm khách: Tất cả"]]></textFieldExpression>
