<?xml version="1.0" encoding="UTF-8"?>
<jasperReport whenNoDataType="AllSectionsNoDetail"
              xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="bao_cao_chi_tiet_hang_khuyen_mai"
              pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">

    <parameter name="p_companyName" class="java.lang.String"/>
    <parameter name="p_companyAddress" class="java.lang.String"/>
    <parameter name="p_companyPhone" class="java.lang.String"/>
    <parameter name="p_companyEmail" class="java.lang.String"/>
    <parameter name="p_logoImage" class="java.lang.Object"/>
    <parameter name="p_reportTitle" class="java.lang.String"/>
    <parameter name="p_tuNgay" class="java.lang.String"/>
    <parameter name="p_denNgay" class="java.lang.String"/>

    <field name="stt" class="java.lang.Integer"/>
    <field name="soPhieu" class="java.lang.String"/>
    <field name="ngay" class="java.lang.String"/>
    <field name="tenKhachHang" class="java.lang.String"/>
    <field name="khuyenMai" class="java.lang.String"/>
    <field name="soLuong" class="java.lang.Double"/>

    <variable name="v_totalSoLuong" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{soLuong}]]></variableExpression>
    </variable>

    <title>
        <band height="100">
            <image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" onErrorType="Blank">
                <reportElement x="0" y="0" width="100" height="50"/>
                <imageExpression><![CDATA[$P{p_logoImage}]]></imageExpression>
            </image>
            <textField isBlankWhenNull="true">
                <reportElement x="160" y="0" width="375" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{p_companyName} != null ? $P{p_companyName} : "Công ty TNHH Ngọc Châu Âu"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="160" y="18" width="375" height="15"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Địa chỉ: " + ($P{p_companyAddress} != null ? $P{p_companyAddress} : "455 Sư Vạn Hạnh, P.12, Q.10, TPHCM")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="160" y="33" width="375" height="15"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Điện thoại: " + ($P{p_companyPhone} != null ? $P{p_companyPhone} : "(08) 6264 5788") + ($P{p_companyEmail} != null && !$P{p_companyEmail}.isEmpty() ? ", Email: " + $P{p_companyEmail} : "")]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="160" y="55" width="375" height="22"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{p_reportTitle} != null ? $P{p_reportTitle} : "BÁO CÁO CHI TIẾT HÀNG KHUYẾN MẠI"]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="160" y="77" width="375" height="15"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Ngày từ " + ($P{p_tuNgay} != null ? $P{p_tuNgay} : "") + " đến " + ($P{p_denNgay} != null ? $P{p_denNgay} : "")]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="24">
            <staticText>
                <reportElement mode="Opaque" x="0" y="0" width="35" height="24" backcolor="#FFFFFF"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[STT]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="35" y="0" width="90" height="24" backcolor="#FFFFFF"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Số phiếu]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="125" y="0" width="75" height="24" backcolor="#FFFFFF"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Ngày]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="200" y="0" width="160" height="24" backcolor="#FFFFFF"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Tên khách hàng]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="360" y="0" width="115" height="24" backcolor="#FFFFFF"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Khuyến mại]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="475" y="0" width="60" height="24" backcolor="#FFFFFF"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Số lượng]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="35" height="20"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{stt}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="35" y="0" width="90" height="20"/>
                <box leftPadding="4"><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{soPhieu}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="125" y="0" width="75" height="20"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{ngay}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="200" y="0" width="160" height="20"/>
                <box leftPadding="4"><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{tenKhachHang}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="360" y="0" width="115" height="20"/>
                <box leftPadding="4"><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{khuyenMai}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0" isBlankWhenNull="true">
                <reportElement x="475" y="0" width="60" height="20"/>
                <box rightPadding="4"><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{soLuong}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="100">
            <staticText>
                <reportElement x="30" y="30" width="180" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <text><![CDATA[Trưởng phòng]]></text>
            </staticText>
            <staticText>
                <reportElement x="30" y="46" width="180" height="14"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isItalic="true"/></textElement>
                <text><![CDATA[(Ký, họ tên)]]></text>
            </staticText>
            <staticText>
                <reportElement x="325" y="30" width="180" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <text><![CDATA[Người lập]]></text>
            </staticText>
            <staticText>
                <reportElement x="325" y="46" width="180" height="14"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isItalic="true"/></textElement>
                <text><![CDATA[(Ký, họ tên)]]></text>
            </staticText>
        </band>
    </summary>
</jasperReport>
