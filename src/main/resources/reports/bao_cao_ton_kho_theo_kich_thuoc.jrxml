<?xml version="1.0" encoding="UTF-8"?>
<jasperReport whenNoDataType="AllSectionsNoDetail"
              xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="bao_cao_ton_kho_theo_kich_thuoc"
              pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">

    <parameter name="p_companyName" class="java.lang.String"/>
    <parameter name="p_companyAddress" class="java.lang.String"/>
    <parameter name="p_companyPhone" class="java.lang.String"/>
    <parameter name="p_companyEmail" class="java.lang.String"/>
    <parameter name="p_logoImage" class="java.lang.Object"/>
    <parameter name="p_reportTitle" class="java.lang.String"/>

    <field name="stt" class="java.lang.Integer"/>
    <field name="groupNhom" class="java.lang.String"/>
    <field name="maHang" class="java.lang.String"/>
    <field name="tenHang" class="java.lang.String"/>
    <field name="dvt" class="java.lang.String"/>
    <field name="ton" class="java.lang.Double"/>
    <field name="chiTiet" class="java.lang.Double"/>

    <group name="GroupNhom">
        <groupExpression><![CDATA[$F{groupNhom}]]></groupExpression>
        <groupHeader>
            <band height="20">
                <printWhenExpression><![CDATA[$F{groupNhom} != null && !$F{groupNhom}.isEmpty()]]></printWhenExpression>
                <textField isBlankWhenNull="true">
                    <reportElement x="0" y="0" width="535" height="20"/>
                    <box leftPadding="5">
                        <topPen lineWidth="0.5" lineColor="#808080"/>
                        <leftPen lineWidth="0.5" lineColor="#808080"/>
                        <bottomPen lineWidth="0.5" lineColor="#808080"/>
                        <rightPen lineWidth="0.5" lineColor="#808080"/>
                    </box>
                    <textElement verticalAlignment="Middle">
                        <font fontName="SansSerif" size="9" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$F{groupNhom}]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
    </group>

    <title>
        <band height="90">
            <image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" onErrorType="Blank">
                <reportElement x="0" y="0" width="100" height="50"/>
                <imageExpression><![CDATA[$P{p_logoImage}]]></imageExpression>
            </image>
            <textField isBlankWhenNull="true">
                <reportElement x="160" y="0" width="375" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{p_companyName} != null ? $P{p_companyName} : "Công ty TNHH Ngọc Châu Âu"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="160" y="18" width="375" height="15"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Địa chỉ: " + ($P{p_companyAddress} != null ? $P{p_companyAddress} : "455 Sư Vạn Hạnh, P.12, Q.10, TPHCM")]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="160" y="33" width="375" height="15"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Điện thoại: " + ($P{p_companyPhone} != null ? $P{p_companyPhone} : "(08) 6264 5788") + ($P{p_companyEmail} != null && !$P{p_companyEmail}.isEmpty() ? ", Email: " + $P{p_companyEmail} : "")]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="120" y="55" width="415" height="22"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{p_reportTitle} != null ? $P{p_reportTitle} : "BÁO CÁO TỒN KHO THEO KÍCH THƯỚC"]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="24">
            <staticText>
                <reportElement mode="Opaque" x="0" y="0" width="80" height="24" backcolor="#FFFFFF"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Mã hàng]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="80" y="0" width="225" height="24" backcolor="#FFFFFF"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Tên hàng]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="305" y="0" width="60" height="24" backcolor="#FFFFFF"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[ĐVT]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="365" y="0" width="70" height="24" backcolor="#FFFFFF"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Tồn]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="435" y="0" width="100" height="24" backcolor="#FFFFFF"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Chi tiết]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="80" height="18"/>
                <box leftPadding="4"><topPen lineWidth="0.5" lineColor="#808080"/><leftPen lineWidth="0.5" lineColor="#808080"/><bottomPen lineWidth="0.5" lineColor="#808080"/><rightPen lineWidth="0.5" lineColor="#808080"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{maHang}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="80" y="0" width="225" height="18"/>
                <box leftPadding="4"><topPen lineWidth="0.5" lineColor="#808080"/><leftPen lineWidth="0.5" lineColor="#808080"/><bottomPen lineWidth="0.5" lineColor="#808080"/><rightPen lineWidth="0.5" lineColor="#808080"/></box>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{tenHang}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="305" y="0" width="60" height="18"/>
                <box><topPen lineWidth="0.5" lineColor="#808080"/><leftPen lineWidth="0.5" lineColor="#808080"/><bottomPen lineWidth="0.5" lineColor="#808080"/><rightPen lineWidth="0.5" lineColor="#808080"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{dvt}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.##" isBlankWhenNull="true">
                <reportElement x="365" y="0" width="70" height="18"/>
                <box rightPadding="4"><topPen lineWidth="0.5" lineColor="#808080"/><leftPen lineWidth="0.5" lineColor="#808080"/><bottomPen lineWidth="0.5" lineColor="#808080"/><rightPen lineWidth="0.5" lineColor="#808080"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{ton}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.##" isBlankWhenNull="true">
                <reportElement x="435" y="0" width="100" height="18"/>
                <box rightPadding="4"><topPen lineWidth="0.5" lineColor="#808080"/><leftPen lineWidth="0.5" lineColor="#808080"/><bottomPen lineWidth="0.5" lineColor="#808080"/><rightPen lineWidth="0.5" lineColor="#808080"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{chiTiet}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="400" y="0" width="135" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Trang " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
